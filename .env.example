# Copiez ce fichier en .env puis renseignez vos valeurs. Ne versionnez JAMAIS .env.
MISTRAL_API_KEY=votre_cle_ici

# Jeton protégeant l'endpoint /rebuild de l'API (étape 5)
REBUILD_TOKEN=changez_moi

# Zone géographique du POC (nom exact du département dans OpenAgenda)
EVENTS_DEPARTMENT=Loire-Atlantique

# Optionnel : date « aujourd'hui » fixe (AAAA-MM-JJ) pour un traitement reproductible
# REFERENCE_DATE=2026-09-19
